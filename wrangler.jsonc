{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "newsite",
  "main": "worker.js",
  "compatibility_date": "2026-10-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Não remove o .html das URLs (o padrão do Cloudflare redireciona
    // /sobre.html -> /sobre); index, pastas e 404 ficam com o worker.js
    "html_handling": "none",
    // Toda requisição passa pelo worker.js primeiro, para redirecionar
    // www e http para https://momentvmopvs.com
    "run_worker_first": true
  }
}
